# VSG command rules for Codex in VSG-WordPress-OpenSource.
# Prefix rules only add friction; they are not an authorization (see AGENTS.md, authorization matrix).
# The most restrictive matching rule wins. Restart Codex after editing this file.
# Check a command with: codex execpolicy check --pretty --rules .codex/rules/vsg.rules -- <command>
# tools/agent-policy/guard.mjs (PreToolUse hook) covers variants these exact prefixes miss.

# ---------- forbidden: history rewrite, discarding work, extra checkouts ----------

prefix_rule(pattern = ["git", "push", "--force"], decision = "forbidden", justification = "Force-push is forbidden.")
prefix_rule(pattern = ["git", "push", "-f"], decision = "forbidden", justification = "Force-push is forbidden.")
prefix_rule(pattern = ["git", "push", "--force-with-lease"], decision = "forbidden", justification = "Force-push is forbidden.")
prefix_rule(pattern = ["git", "push", "--mirror"], decision = "forbidden", justification = "Mirror push overwrites remote refs.")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden", justification = "git reset --hard discards work.")
prefix_rule(pattern = ["git", "clean", "-f"], decision = "forbidden", justification = "git clean deletes untracked files that may belong to someone else.")
prefix_rule(pattern = ["git", "clean", "-fd"], decision = "forbidden", justification = "git clean deletes untracked files that may belong to someone else.")
prefix_rule(pattern = ["git", "clean", "-df"], decision = "forbidden", justification = "git clean deletes untracked files that may belong to someone else.")
prefix_rule(pattern = ["git", "clean", "-fdx"], decision = "forbidden", justification = "git clean deletes untracked files that may belong to someone else.")
prefix_rule(pattern = ["git", "clean", "-dfx"], decision = "forbidden", justification = "git clean deletes untracked files that may belong to someone else.")
prefix_rule(pattern = ["git", "clean", "-xdf"], decision = "forbidden", justification = "git clean deletes untracked files that may belong to someone else.")
prefix_rule(pattern = ["git", "clean", "-xfd"], decision = "forbidden", justification = "git clean deletes untracked files that may belong to someone else.")
prefix_rule(pattern = ["git", "clean", "-fx"], decision = "forbidden", justification = "git clean deletes untracked files that may belong to someone else.")
prefix_rule(pattern = ["git", "clean", "-xf"], decision = "forbidden", justification = "git clean deletes untracked files that may belong to someone else.")
prefix_rule(pattern = ["git", "clean", "--force"], decision = "forbidden", justification = "git clean deletes untracked files that may belong to someone else.")
prefix_rule(pattern = ["git", "add", "-A"], decision = "forbidden", justification = "Stage explicit paths; git add -A is forbidden.")
prefix_rule(pattern = ["git", "add", "--all"], decision = "forbidden", justification = "Stage explicit paths; git add --all is forbidden.")
prefix_rule(pattern = ["git", "add", "."], decision = "forbidden", justification = "Stage explicit paths; git add . is forbidden.")
prefix_rule(pattern = ["git", "worktree", "add"], decision = "forbidden", justification = "Extra worktrees need a bounded owner exception.")
prefix_rule(pattern = ["git", "clone"], decision = "forbidden", justification = "Extra clones need a bounded owner exception.")
prefix_rule(pattern = ["git", "filter-branch"], decision = "forbidden", justification = "History rewrite is forbidden.")
prefix_rule(pattern = ["git", "filter-repo"], decision = "forbidden", justification = "History rewrite is forbidden.")
prefix_rule(pattern = ["gh", "repo", "delete"], decision = "forbidden", justification = "Deleting a repository is forbidden.")
prefix_rule(pattern = ["gh", "repo", "clone"], decision = "forbidden", justification = "Extra clones need a bounded owner exception.")

prefix_rule(pattern = ["git", "push", "--delete"], decision = "forbidden", justification = "Deleting remote branches is forbidden.")
prefix_rule(pattern = ["git", "push", "-d"], decision = "forbidden", justification = "Deleting remote branches is forbidden.")
prefix_rule(pattern = ["git", "add", ":/"], decision = "forbidden", justification = "Stage explicit paths only.")
prefix_rule(pattern = ["gh", "repo", "archive"], decision = "forbidden", justification = "Archiving a repository belongs to the owner.")
prefix_rule(pattern = ["gh", "repo", "rename"], decision = "forbidden", justification = "Renaming a repository belongs to the owner.")

# ---------- prompt: needs an explicit owner authorization for this run ----------

prefix_rule(pattern = ["git", "push"], decision = "prompt", justification = "Push needs explicit owner authorization.")
prefix_rule(pattern = ["git", "rebase"], decision = "prompt", justification = "Rebase rewrites history.")
prefix_rule(pattern = ["git", "tag"], decision = "prompt", justification = "Tags mark releases and need an owner order.")
prefix_rule(pattern = ["npm", "install"], decision = "prompt", justification = "Installing dependencies needs owner authorization.")
prefix_rule(pattern = ["npm", "i"], decision = "prompt", justification = "Installing dependencies needs owner authorization.")
prefix_rule(pattern = ["npm", "ci"], decision = "prompt", justification = "Installing dependencies needs owner authorization.")
prefix_rule(pattern = ["npm", "add"], decision = "prompt", justification = "Installing dependencies needs owner authorization.")
prefix_rule(pattern = ["npm", "update"], decision = "prompt", justification = "Updating dependencies needs owner authorization.")
prefix_rule(pattern = ["npm", "uninstall"], decision = "prompt", justification = "Changing dependencies needs owner authorization.")
prefix_rule(pattern = ["npm", "run"], decision = "prompt", justification = "Builds and scripts need owner authorization.")
prefix_rule(pattern = ["npm", "test"], decision = "prompt", justification = "Tests need owner authorization.")
prefix_rule(pattern = ["npm", "exec"], decision = "prompt", justification = "Running packages needs owner authorization.")
prefix_rule(pattern = ["npm", "publish"], decision = "prompt", justification = "Publishing needs an explicit owner order.")
prefix_rule(pattern = ["npm", "pack"], decision = "prompt", justification = "Packaging needs owner authorization.")
prefix_rule(pattern = ["pnpm", "install"], decision = "prompt", justification = "Installing dependencies needs owner authorization.")
prefix_rule(pattern = ["pnpm", "i"], decision = "prompt", justification = "Installing dependencies needs owner authorization.")
prefix_rule(pattern = ["pnpm", "add"], decision = "prompt", justification = "Installing dependencies needs owner authorization.")
prefix_rule(pattern = ["pnpm", "update"], decision = "prompt", justification = "Updating dependencies needs owner authorization.")
prefix_rule(pattern = ["pnpm", "remove"], decision = "prompt", justification = "Changing dependencies needs owner authorization.")
prefix_rule(pattern = ["pnpm", "run"], decision = "prompt", justification = "Builds and scripts need owner authorization.")
prefix_rule(pattern = ["pnpm", "test"], decision = "prompt", justification = "Tests need owner authorization.")
prefix_rule(pattern = ["pnpm", "exec"], decision = "prompt", justification = "Running packages needs owner authorization.")
prefix_rule(pattern = ["pnpm", "dlx"], decision = "prompt", justification = "Running packages needs owner authorization.")
prefix_rule(pattern = ["pnpm", "publish"], decision = "prompt", justification = "Publishing needs an explicit owner order.")
prefix_rule(pattern = ["pnpm", "pack"], decision = "prompt", justification = "Packaging needs owner authorization.")
prefix_rule(pattern = ["yarn"], decision = "prompt", justification = "Yarn installs or runs code; needs owner authorization.")
prefix_rule(pattern = ["bun"], decision = "prompt", justification = "Bun installs or runs code; needs owner authorization.")
prefix_rule(pattern = ["npx"], decision = "prompt", justification = "Running packages needs owner authorization.")
prefix_rule(pattern = ["pnpx"], decision = "prompt", justification = "Running packages needs owner authorization.")
prefix_rule(pattern = ["bunx"], decision = "prompt", justification = "Running packages needs owner authorization.")
prefix_rule(pattern = ["composer", "install"], decision = "prompt", justification = "Installing dependencies needs owner authorization.")
prefix_rule(pattern = ["composer", "update"], decision = "prompt", justification = "Updating dependencies needs owner authorization.")
prefix_rule(pattern = ["composer", "require"], decision = "prompt", justification = "Changing dependencies needs owner authorization.")
prefix_rule(pattern = ["composer", "remove"], decision = "prompt", justification = "Changing dependencies needs owner authorization.")
prefix_rule(pattern = ["composer", "create-project"], decision = "prompt", justification = "Scaffolding needs owner authorization.")
prefix_rule(pattern = ["composer", "run-script"], decision = "prompt", justification = "Scripts need owner authorization.")
prefix_rule(pattern = ["ng"], decision = "prompt", justification = "Angular CLI builds, serves, tests or scaffolds; needs owner authorization.")
prefix_rule(pattern = ["node"], decision = "prompt", justification = "Running scripts needs owner authorization.")
prefix_rule(pattern = ["wp-env"], decision = "prompt", justification = "Local WordPress environments need owner authorization.")
prefix_rule(pattern = ["wp"], decision = "prompt", justification = "WP-CLI changes a site; needs owner authorization.")
prefix_rule(pattern = ["docker"], decision = "prompt", justification = "Containers need owner authorization.")
prefix_rule(pattern = ["docker-compose"], decision = "prompt", justification = "Containers need owner authorization.")
prefix_rule(pattern = ["phpunit"], decision = "prompt", justification = "Tests need owner authorization.")
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "prompt", justification = "Merging needs explicit owner authorization.")
prefix_rule(pattern = ["gh", "release", "create"], decision = "prompt", justification = "Releases need an explicit owner order.")
prefix_rule(pattern = ["gh", "release", "upload"], decision = "prompt", justification = "Releases need an explicit owner order.")
prefix_rule(pattern = ["gh", "release", "edit"], decision = "prompt", justification = "Releases need an explicit owner order.")
prefix_rule(pattern = ["gh", "release", "delete"], decision = "prompt", justification = "Releases need an explicit owner order.")
prefix_rule(pattern = ["gh", "repo", "edit"], decision = "prompt", justification = "Repository settings belong to the owner.")
prefix_rule(pattern = ["gh", "repo", "create"], decision = "prompt", justification = "New repositories need an owner order.")
prefix_rule(pattern = ["gh", "workflow", "run"], decision = "prompt", justification = "Running CI needs owner authorization.")

# ---------- prompt: forms a plain prefix cannot see past, interpreters, network, GitHub writes ----------

prefix_rule(pattern = ["git", "-C"], decision = "prompt", justification = "Git options that redirect the repository or config hide the real operation.")
prefix_rule(pattern = ["git", "-c"], decision = "prompt", justification = "Git options that redirect the repository or config hide the real operation.")
prefix_rule(pattern = ["git", "--git-dir"], decision = "prompt", justification = "Git options that redirect the repository or config hide the real operation.")
prefix_rule(pattern = ["git", "--work-tree"], decision = "prompt", justification = "Git options that redirect the repository or config hide the real operation.")
prefix_rule(pattern = ["git", "reset"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "clean"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "restore"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "checkout", "--"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "checkout", "."], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "stash", "drop"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "stash", "clear"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "branch", "-D"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "branch", "-d"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "branch", "--delete"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "worktree"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "update-ref"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "reflog", "expire"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "gc", "--prune"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")

prefix_rule(pattern = ["git", "remote", "rm"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "config", "--global"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["svn", "commit"], decision = "prompt", justification = "Commits to WordPress.org SVN are releases.")
prefix_rule(pattern = ["svn", "ci"], decision = "prompt", justification = "Commits to WordPress.org SVN are releases.")
prefix_rule(pattern = ["python"], decision = "prompt", justification = "Interpreters run code the policy hook cannot inspect.")
prefix_rule(pattern = ["python3"], decision = "prompt", justification = "Interpreters run code the policy hook cannot inspect.")
prefix_rule(pattern = ["py"], decision = "prompt", justification = "Interpreters run code the policy hook cannot inspect.")

prefix_rule(pattern = ["git", "init"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "submodule"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "commit", "--amend"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "remote", "add"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")
prefix_rule(pattern = ["git", "remote", "set-url"], decision = "prompt", justification = "Git operation outside a plain commit needs owner authorization.")

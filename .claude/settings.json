  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/agent-policy/guard.mjs",
              "--client",
              "claude"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
